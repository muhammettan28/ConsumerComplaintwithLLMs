\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Weighted F1-scores for all eleven models in Experiment~A (Balanced), shown as mean~$\pm $~std over three seeds. Reasoning models are shown in dark blue; standard models in light blue. \texttt  {gemma4:12b} (standard) leads all reasoning models.}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:f1_bar}{{3}{8}{Weighted F1-scores for all eleven models in Experiment~A (Balanced), shown as mean~$\pm $~std over three seeds. Reasoning models are shown in dark blue; standard models in light blue. \texttt {gemma4:12b} (standard) leads all reasoning models}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Averaged confusion matrices for selected models (Experiment~A, $N{=}1{,}000$, mean over 3~seeds). Rows: true labels; columns: predicted labels. (a)~\texttt  {gpt-oss:20b}: top reasoning model, handles \texttt  {credit\_reporting} and \texttt  {retail\_banking} well with some confusion between \texttt  {mortgages\_and\_loans} and \texttt  {credit\_card}. (b)~\texttt  {phi4:14b}: best sub-1-second standard model, strong diagonal with minor confusion. (c)~\texttt  {deepseek-r1:14b}: second reasoning model, near-zero off-label rate; main confusions between \texttt  {credit\_card} and \texttt  {mortgages\_and\_loans}.}}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:conf_all}{{4}{8}{Averaged confusion matrices for selected models (Experiment~A, $N{=}1{,}000$, mean over 3~seeds). Rows: true labels; columns: predicted labels. (a)~\texttt {gpt-oss:20b}: top reasoning model, handles \texttt {credit\_reporting} and \texttt {retail\_banking} well with some confusion between \texttt {mortgages\_and\_loans} and \texttt {credit\_card}. (b)~\texttt {phi4:14b}: best sub-1-second standard model, strong diagonal with minor confusion. (c)~\texttt {deepseek-r1:14b}: second reasoning model, near-zero off-label rate; main confusions between \texttt {credit\_card} and \texttt {mortgages\_and\_loans}}{figure.caption.6}{}}
